<?xml version="1.1" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
                   
  <changeSet id="1-Create_identifier_type_controlled_vocabulary" context="initial-data" author="cgendreau">
    <insert tableName="controlled_vocabulary">
      <column name="uuid" value="bff566b9-4044-4e0c-a9cd-0ab22c6f0e5b"/>
      <column name="name" value="Identifier Type"/>
      <column name="key" value="identifier_type"/>
      <column name="type" value="SYSTEM"/>
      <column name="vocab_class" value="QUALIFIED_VALUE"/>
      <column name="version" value="1"/>
      <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Identifier Type"},{"lang":"fr","title":"Type d’identifiant"}]}'/>
      <column name="created_by" value="system"/>
    </insert>
  </changeSet>

  <changeSet id="1-Create_identifier_type_controlled_vocabulary_add_items" context="initial-data" author="cgendreau">
    <insert tableName="controlled_vocabulary_item">
      <column name="uuid" value="32c99f08-c659-4821-a086-81b44f5e9fc1"/>
      <column name="controlled_vocabulary_id" valueComputed="(SELECT id FROM controlled_vocabulary WHERE uuid='bff566b9-4044-4e0c-a9cd-0ab22c6f0e5b')"/>
      <column name="name" value="ORCID"/>
      <column name="key" value="orcid"/>
      <column name="term" value="http://www.wikidata.org/entity/Q51044"/>
      <column name="_group" value="system"/>
      <column name="dina_component" value="PERSON"/>
      <column name="vocabulary_element_type" value="STRING"/>
      <column name="uri_template" value="https://orcid.org/$1"/>
      <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"ORCID"}]}'/>
      <column name="multilingual_description" value='{
          "descriptions": [
          {
          "lang": "en",
          "desc": "Nonproprietary alphanumeric code to uniquely identify individuals as they engage in research, scholarship, and innovation activities. https://orcid.org/"
          }
          ]
          }'/>
      <column name="created_by" value="system"/>
    </insert>

    <insert tableName="controlled_vocabulary_item">
      <column name="uuid" value="19fe1a2a-3fe4-4477-b1a9-f039b6dd71bc"/>
      <column name="controlled_vocabulary_id" valueComputed="(SELECT id FROM controlled_vocabulary WHERE uuid='bff566b9-4044-4e0c-a9cd-0ab22c6f0e5b')"/>
      <column name="name" value="WIKIDATA"/>
      <column name="key" value="wikidata"/>
      <column name="term" value="http://www.wikidata.org/entity/Q2013"/>
      <column name="_group" value="system"/>
      <column name="dina_component" value="PERSON"/>
      <column name="vocabulary_element_type" value="STRING"/>
      <column name="uri_template" value="http://www.wikidata.org/entity/$1"/>
      <column name="multilingual_title" value='{"titles":[{"lang":"en","title":"Wikidata"}]}'/>
      <column name="multilingual_description" value='{
          "descriptions": [
          {
          "lang": "en",
          "desc": "Open multilingual online knowledge graph. https://www.wikidata.org/"
          }
          ]
          }'/>
      <column name="created_by" value="system"/>
    </insert>
    </changeSet>
</databaseChangeLog>
